<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eluna.hornerolauncher.controllers.HorneroController"
            styleClass="gorrion-root">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <!-- Arriba a la izquierda -->
    <top>
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="welcomeText" text="Bienvenido!" styleClass="welcome-label"/>
            <BorderPane.margin>
                <Insets bottom="20.0"/>
            </BorderPane.margin>
        </HBox>
    </top>

    <!-- Tarjeta central flotante (para noticias, versión, progreso, etc.) -->
    <center>
        <StackPane styleClass="card"/>
    </center>

    <!-- Botones abajo -->
    <bottom>
        <HBox spacing="14.0" alignment="CENTER">
            <BorderPane.margin>
                <Insets top="20.0"/>
            </BorderPane.margin>

            <Button text="Descargar" fx:id="botonDescargar" onAction="#descargar"
                    styleClass="btn, btn-gorrion, btn-gorrion-secondary"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <FontIcon iconLiteral="fa-download"/>
                </graphic>
            </Button>

            <Button text="Jugar" fx:id="botonEjecutar" onAction="#ejecutarJuego"
                    styleClass="btn, btn-gorrion, btn-gorrion-primary"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <FontIcon iconLiteral="fa-play"/>
                </graphic>
            </Button>
        </HBox>
    </bottom>
</BorderPane>